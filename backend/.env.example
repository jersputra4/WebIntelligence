# EnsembleData credentials — NEVER commit the real key.
ENSEMBLEDATA_API_KEY=
ENSEMBLEDATA_BASE_URL=https://ensembledata.com/apis
# Daily unit allowance of your EnsembleData plan (used to compute "Quota Remaining").
ENSEMBLEDATA_DAILY_UNITS=1000

# auto = live when an API key is set, otherwise demo (synthetic data)
# live = always call EnsembleData, mock = always synthetic data
PROVIDER_MODE=auto

APP_ENV=development
REQUEST_TIMEOUT=15
REQUEST_RETRIES=1

# Rate limit for /api/search (per client IP)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Set true only when running behind a reverse proxy you control (uses X-Forwarded-For)
TRUST_PROXY_HEADERS=false

# Comma separated origins allowed by CORS (frontend is same-origin by default)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DATABASE_PATH=data/intel.db
LOG_LEVEL=INFO
